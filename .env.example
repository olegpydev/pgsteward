# pgsteward configuration example.
#
#   mkdir -p ~/.config/pgsteward
#   cp .env.example ~/.config/pgsteward/.env
#   chmod 600 ~/.config/pgsteward/.env
#
# pgsteward finds that file on its own. Any other location needs
# PGSTEWARD_ENV_FILE, which must be set in the process environment: setting
# it inside this file has no effect. This file holds database passwords.
# See docs/configuration.md#where-credentials-come-from and docs/security.md.

# Logging level (stderr). Default: INFO.
PGSTEWARD_LOG_LEVEL=INFO

# Optional cross-database relationship map. Read from
# ~/.config/pgsteward/relationships.json unless set here; no file at all
# means the federation tools are simply absent. Format and behaviour on a
# broken file: docs/tools.md#cross-database-links-optional.
# PGSTEWARD_RELATIONSHIPS_FILE=/absolute/path/to/relationships.json

# Id suffixes reported as `environment` in list_connections, so the agent
# can tell production apart before it queries it. A label only — writes are
# stopped by READ_ONLY and ALLOW_DML/ALLOW_DDL below. The same list lets one
# relationship map serve every environment. Unset by default: no list, no
# label. See docs/configuration.md#environments.
# PGSTEWARD_ENV_SUFFIXES=prod,staging,dev

# --- Connections ---------------------------------------------------------
# Connection metadata as CSV of `id:prefix` records. No credentials here.
#   id     — identifier the agent uses (may contain dashes)
#   prefix — prefix of the env block holding credentials (default: id.upper())
PGSTEWARD_DB_CONNECTIONS=web-shop:WEB_SHOP

# Global write policy. Everything is forbidden by default.
PGSTEWARD_SECURITY_ALLOW_DML=false
PGSTEWARD_SECURITY_ALLOW_DDL=false

# Credentials, read by prefix as a `<PREFIX>_PG_*` block.
# HOST, USER and DATABASE are required and none of them is guessed; a
# connection missing one is reported as `misconfigured`.
WEB_SHOP_PG_HOST=127.0.0.1
WEB_SHOP_PG_USER=readonly_user
WEB_SHOP_PG_DATABASE=web_shop
WEB_SHOP_PG_PORT=5432
# Empty means the same as omitting the line: no password is sent, leaving
# PGPASSWORD, .pgpass, trust, peer and TLS client certificates to work.
# See docs/security.md#not-storing-a-password-at-all.
WEB_SHOP_PG_PASSWORD=

# Instead of the four variables above, a full connection URI, for what
# discrete fields cannot express. The discrete fields are then ignored.
#
# Unix socket + peer: no secret anywhere.
# WEB_SHOP_PG_DSN=postgresql://readonly_user@/web_shop?host=/var/run/postgresql
#
# TLS client certificate instead of a password:
# WEB_SHOP_PG_DSN=postgresql://readonly_user@db.example.com:5432/web_shop?sslmode=verify-full&sslrootcert=/etc/ssl/ca.crt&sslcert=/etc/ssl/client.crt&sslkey=/etc/ssl/client.key
#
# Unrecognised query parameters become session settings, which is how a
# connection gets its own search_path: docs/configuration.md#transport.

# Optional per-connection settings:
# WEB_SHOP_PG_READ_ONLY=true      # default true
# WEB_SHOP_PG_SSLMODE=require     # unset leaves asyncpg's `prefer`, which
#                                 # falls back to plaintext silently
# WEB_SHOP_PG_QUERY_TIMEOUT=30    # seconds, at least 1
# WEB_SHOP_PG_MAX_ROWS=1000       # -1 disables the cap; 0 is refused
# WEB_SHOP_PG_MAX_BYTES=100000    # size of the rows returned; bytes are what
#                                 # a context window runs out of, and one
#                                 # wide row can be 300x another
# WEB_SHOP_PG_POOL_MIN=1
# WEB_SHOP_PG_POOL_MAX=5
# WEB_SHOP_PG_ALLOW_DML=false     # overrides PGSTEWARD_SECURITY_ALLOW_DML
# WEB_SHOP_PG_ALLOW_DDL=false     # overrides PGSTEWARD_SECURITY_ALLOW_DDL

# --- Multiple environments -----------------------------------------------
# Add a second block to serve staging and production from one process.
# Worked example: docs/configuration.md#environments
#
# PGSTEWARD_DB_CONNECTIONS=web-shop,web-shop-prod
# PGSTEWARD_ENV_SUFFIXES=prod
# WEB_SHOP_PROD_PG_HOST=prod-host
# WEB_SHOP_PROD_PG_USER=readonly_user
# WEB_SHOP_PROD_PG_DATABASE=web_shop
# # Explicit write ban, independent of the global policy:
# WEB_SHOP_PROD_PG_ALLOW_DML=false
# WEB_SHOP_PROD_PG_ALLOW_DDL=false

# --- Integration tests ---------------------------------------------------
# DSN of a throwaway PostgreSQL used by `pytest -m integration`.
# Unset means integration tests are skipped.
# PGSTEWARD_TEST_DSN=postgresql://postgres:postgres@127.0.0.1:5432/pgsteward_test
